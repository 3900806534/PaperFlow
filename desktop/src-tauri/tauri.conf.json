{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "PaperFlow",
  "version": "1.0.0",
  "identifier": "com.paperflow.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PaperFlow - 试卷学习工具",
        "width": 1100,
        "height": 750,
        "center": true,
        "resizable": true,
        "visible": true
      },
      {
        "label": "floatball",
        "title": "PaperFlow",
        "width": 48,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": true,
        "url": "floatball.html",
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": ["icons/icon.ico"]
  },
  "plugins": {}
}
